# OS / editor junk
.DS_Store
Thumbs.db
desktop.ini
*.swp

# Noita writes a per-mod settings cache at runtime; keep source settings.lua, ignore generated state
mod_config.xml

# Python bytecode (from tools/)
__pycache__/
*.pyc

# Release zips built by tools/make_release.sh (uploaded to GitHub Releases)
/dist/

# Local planning scratch (not for the repo)
/NEXT_UPDATE_PLAN.md

# Internal-only docs: kept local for development, not published to the repo
/CLAUDE.md
/docs/STATUS.md

# gun_ref: Game files extracted from data.wak for the differential harness.
# Noita content -- never commit these (see tools/extract_gun.py).
/.gun_ref/
